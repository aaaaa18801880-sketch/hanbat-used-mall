                    ))}
                  </div>
                </div>
              )}

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className={LABEL}>판매 가격 (원)</label>
                  <input
                    type="text"
                    inputMode="numeric"
                    value={productPrice ? Number(productPrice).toLocaleString() : ""}
