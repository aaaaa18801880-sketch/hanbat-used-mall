export function Icon({
  d,
  className = "w-4 h-4",
  strokeWidth = 2,
  ...props
}: {
  d: string;
  className?: string;
  strokeWidth?: number;
  [key: string]: any;
}) {
  return (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth={strokeWidth}
      strokeLinecap="round"
      strokeLinejoin="round"
      className={className}
      {...props}
    >
      <path d={d} />
    </svg>
  );
}

/* 안전 이미지 컴포넌트 (SafeImg) */
export function SafeImg({
  src,
  alt = "",
  className = "",
  eager = false,
  ...props
}: {
  src?: string | null;
  alt?: string;
  className?: string;
  eager?: boolean;
  [key: string]: any;
}) {
  const [error, setError] = useState(false);

  useEffect(() => {
    setError(false);
  }, [src]);

  if (!src || error) {
    return (
      <div className={`flex items-center justify-center bg-[#EFECE6] text-[#8A8478] text-[12px] font-medium select-none ${className}`}>
        이미지 준비중
      </div>
    );
  }

  return (
    // eslint-disable-next-line @next/next/no-img-element
    <img
      src={src}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      onError={() => setError(true)}
      className={className}
      {...props}
    />
  );
}

/* 모달 컴포넌트 (Modal) */
export function Modal({
  children,
  onClose,
  label = "모달",
  panelClassName = "",
  overlayClassName = "",
  sheet = false,
}: {
  children: React.ReactNode;
  onClose: () => void;
  label?: string;
  panelClassName?: string;
  overlayClassName?: string;
  sheet?: boolean;
}) {
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") onClose();
    };
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [onClose]);

  return (
    <div
      role="dialog"
      aria-modal="true"
      aria-label={label}
      className={`fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/60 backdrop-blur-xs animate-fadeIn ${overlayClassName}`}
      onClick={onClose}
    >
      <div
        className={`w-full ${panelClassName}`}
        onClick={(e) => e.stopPropagation()}
      >
        {children}
      </div>
    </div>
  );
}

