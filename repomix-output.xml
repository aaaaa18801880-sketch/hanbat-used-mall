                        className={`py-2.5 rounded font-semibold transition-colors text-[14px] ${
                          (isEditOpen ? editInquiryType : inquiryType) === type
                            ? "bg-white text-[#0E1A2B] shadow-sm"
                            : "text-[#6B7280] hover:text-[#0E1A2B]"
