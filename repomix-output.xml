              {(!isNotice || isEditOpen) && (
                <fieldset>
                  <legend className={LABEL}>문의 구분 *</legend>
                  <div className="grid grid-cols-3 gap-1.5 bg-[#F6F5F2] p-1.5 rounded-md">
