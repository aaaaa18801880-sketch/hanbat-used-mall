                      </div>
                    ))}
                  </div>
                )}
              </div>

              <div className="flex gap-2.5 pt-5 border-t border-[#E4E0D8]">
                <button type="button" onClick={() => { setIsUploadModalOpen(false); resetUploadForm(); }} className={`${BTN_LINE} w-1/2 h-12 text-[14px]`}>취소</button>
